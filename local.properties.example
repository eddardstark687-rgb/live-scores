# Copy this file to local.properties and fill in your keys.
# local.properties is gitignored and must never be committed.

sdk.dir=/path/to/Android/Sdk

# API-Sports (Football) — https://dashboard.api-football.com/
API_KEY_PRIMARY=your_api_sports_primary_key
API_KEY_BACKUP_1=your_api_sports_backup_key_1
API_KEY_BACKUP_2=your_api_sports_backup_key_2

# Google Gemini — https://aistudio.google.com/apikey (home quiz, quotes, facts)
GEMINI_API_KEY=your_gemini_api_key
